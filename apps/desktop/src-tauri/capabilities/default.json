{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core defaults plus Ghira's own commands. No shell, http, fs or opener plugins.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-app-version",
    "allow-start-recording",
    "allow-stop-recording",
    "allow-pause-recording",
    "allow-resume-recording",
    "allow-mark-moment",
    "allow-discard-last",
    "allow-rename-speaker",
    "allow-merge-speakers",
    "allow-split-speaker",
    "allow-speaker-not-a-person",
    "allow-import-recording",
    "allow-quit-app",
    "allow-list-meetings",
    "allow-set-meeting-title",
    "allow-note-lines",
    "allow-add-note-line",
    "allow-update-note-line",
    "allow-delete-note-line",
    "allow-discard-preview",
    "allow-get-settings",
    "allow-update-settings",
    "allow-mic-permission",
    "allow-request-mic-permission",
    "allow-reply-meeting-detected",
    "allow-issue-audio-sample",
    "allow-show-main",
    "allow-set-consent-confirmed",
    "allow-session-snapshot",
    "allow-models-status",
    "allow-download-models",
    "allow-cancel-model-download"
  ]
}
