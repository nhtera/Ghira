{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "popover",
  "description": "Menu-bar popover: record, the current recording, recent meetings, open or quit.",
  "windows": [
    "popover"
  ],
  "permissions": [
    "core:event:default",
    "allow-session-snapshot",
    "allow-get-settings",
    "allow-show-main",
    "allow-start-recording",
    "allow-stop-recording",
    "allow-pause-recording",
    "allow-resume-recording",
    "allow-list-meetings",
    "allow-hide-popover",
    "allow-request-quit-app",
    "allow-mark-moment"
  ]
}
