{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ghi.version/1",
  "type": "object",
  "required": [
    "schema",
    "ghi",
    "core",
    "engines"
  ],
  "properties": {
    "schema": {
      "const": "ghi.version/1"
    },
    "ghi": {
      "type": "string"
    },
    "core": {
      "type": "string"
    },
    "engines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/engine"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "perf": {
      "type": "object",
      "required": [
        "wall_s"
      ],
      "properties": {
        "wall_s": {
          "type": "number",
          "minimum": 0
        },
        "rtf": {
          "type": [
            "number",
            "null"
          ]
        },
        "peak_rss_mb": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "engine": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    }
  }
}
